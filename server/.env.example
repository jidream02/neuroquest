# Скопируйте в .env и заполните. Файл .env НЕ коммитится в git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# auto = ИИ, при сбое офлайн-мастер; ai = только ИИ; mock = только офлайн-мастер
DM_MODE=auto
PORT=8787
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
